  "query": "\n            SELECT target as \"target!\", count(*) as \"count!\"\n            FROM events\n            WHERE kind = 'click' AND target IS NOT NULL AND created_at >= now() - make_interval(days => $1)\n            GROUP BY target\n            ORDER BY count(*) DESC\n            LIMIT 10\n            ",
