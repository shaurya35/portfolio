  "query": "\n            SELECT path as \"path!\", count(*) as \"count!\"\n            FROM events\n            WHERE kind = 'pageview' AND created_at >= now() - make_interval(days => $1)\n            GROUP BY path\n            ORDER BY count(*) DESC\n            LIMIT 10\n            ",
