  "query": "\n            SELECT device as \"device!\", count(*) as \"count!\"\n            FROM events\n            WHERE kind = 'pageview' AND device IS NOT NULL AND created_at >= now() - make_interval(days => $1)\n            GROUP BY device\n            ORDER BY count(*) DESC\n            LIMIT 10\n            ",
