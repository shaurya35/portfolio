{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT target as \"agent!\", count(*) as \"count!\"\n            FROM events\n            WHERE kind = 'agent_fetch' AND target IS NOT NULL AND created_at >= now() - make_interval(days => $1)\n            GROUP BY target\n            ORDER BY count(*) DESC\n            LIMIT 10\n            ",
